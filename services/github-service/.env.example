# ==============================================================================
# CodeBridge GitHub Service — Environment Configuration Example (Phase 4)
# ==============================================================================
# Copy to .env for local development. Never commit real secrets or .env files.

APP_NAME=CodeBridge GitHub Service
APP_ENV=development
DEBUG=false
HOST=0.0.0.0
PORT=8003
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# Async PostgreSQL Database URL (Development placeholder)
DATABASE_URL=postgresql+asyncpg://postgres:change_me_local_only@localhost:5432/codebridge_github
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Synchronous CodeBridge Service Integrations
IDENTITY_SERVICE_URL=http://localhost:8001
PROJECT_SERVICE_URL=http://localhost:8002
SERVICE_CLIENT_TIMEOUT_SECONDS=5.0

# GitHub OAuth App Configuration (Use real OAuth App credentials in .env; NEVER commit real values)
# Note: GitHub OAuth App scope 'repo' grants broad access to repositories accessible to the user;
# CodeBridge restricts downstream project operations strictly to the repository selected per project.
GITHUB_CLIENT_ID=dev-github-client-id-placeholder
GITHUB_CLIENT_SECRET=dev-github-client-secret-placeholder
GITHUB_OAUTH_CALLBACK_URL=http://localhost:8000/api/v1/github/oauth/callback
GITHUB_OAUTH_SCOPES=repo read:user
GITHUB_HTTP_TIMEOUT_SECONDS=10.0
OAUTH_STATE_EXPIRE_SECONDS=600

# Optional Frontend Redirect Targets After OAuth Callback (no tokens appended)
# FRONTEND_OAUTH_SUCCESS_URL=http://localhost:3000/projects/github/connected
# FRONTEND_OAUTH_FAILURE_URL=http://localhost:3000/projects/github/error

# Base64-encoded 32-byte (256-bit) AES-GCM encryption key for OAuth tokens at rest.
# Development-only placeholder below decodes to 32 bytes; MUST be replaced with a random key in staging/production:
# Generate with: python -c "import os, base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
GITHUB_TOKEN_ENCRYPTION_KEY=REVWX09OTFlfSU5TRUNVUkVfS0VZX0RPX05PVF9VU0U=

# GitHub API Pagination & Read Size Safety Caps
GITHUB_API_PAGE_SIZE=50
GITHUB_API_MAX_PAGES=5
GITHUB_CONTENTS_MAX_BYTES=262144
GITHUB_CONTENTS_MAX_ENTRIES=200
