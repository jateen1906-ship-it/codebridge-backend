APP_NAME="CodeBridge Review Service"
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=false
HOST=0.0.0.0
PORT=8006
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# PostgreSQL database owned exclusively by Review Service
DATABASE_URL=postgresql+asyncpg://postgres:change_me_local_only@localhost:5432/codebridge_review
DB_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Peer service URLs (synchronous HTTPX)
IDENTITY_SERVICE_URL=http://localhost:8001
PROJECT_SERVICE_URL=http://localhost:8002
WORKSPACE_SERVICE_URL=http://localhost:8005
NOTIFICATION_SERVICE_URL=http://localhost:8009
AUDIT_SERVICE_URL=http://localhost:8011
SERVICE_CLIENT_TIMEOUT_SECONDS=10.0
INTERNAL_SERVICE_KEY=dev-internal-service-key-change-me
