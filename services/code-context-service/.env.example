# Code Context Service Environment Configuration Example
APP_NAME=CodeBridge Code Context Service
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=false
HOST=0.0.0.0
PORT=8004
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# PostgreSQL database owned exclusively by code-context-service
DATABASE_URL=postgresql+asyncpg://postgres:change_me_local_only@localhost:5432/codebridge_code_context
DB_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Synchronous HTTP/REST peer microservices
IDENTITY_SERVICE_URL=http://localhost:8001
PROJECT_SERVICE_URL=http://localhost:8002
GITHUB_SERVICE_URL=http://localhost:8003
SERVICE_CLIENT_TIMEOUT_SECONDS=10.0

# ChromaDB vector store configuration (never commit vector data directories)
CHROMA_MODE=persistent
CHROMA_PERSIST_DIRECTORY=./chroma_data
CHROMA_COLLECTION_PREFIX=codebridge_project

# Configurable Embedding Provider (openai, ollama, mock)
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_TIMEOUT_SECONDS=15.0
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DIMENSION=64

# Configurable LLM Provider (openai, ollama, mock, none)
LLM_PROVIDER=none
LLM_MODEL=gpt-4o-mini
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=25.0
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=900
LLM_FALLBACK_ON_ERROR=true

# Code chunking & RAG retrieval bounds
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
TOP_K_DEFAULT=5
TOP_K_MAX=15

# Repository ingestion safety limits
MAX_FILES_PER_INDEX=250
MAX_DIRECTORY_TRAVERSALS=100
MAX_DIRECTORY_DEPTH=10
MAX_FILE_BYTES=131072
MAX_TOTAL_REPOSITORY_BYTES=3145728
MAX_INDEX_DURATION_SECONDS=60.0
MAX_CONTENT_RESPONSE_BYTES=16384
INDEX_RETENTION_VERSIONS=2
SUPPORTED_EXTENSIONS=.py,.js,.jsx,.ts,.tsx,.go,.java,.c,.h,.cpp,.hpp,.cc,.cs,.php,.rb,.rs,.html,.css,.scss,.json,.yaml,.yml,.toml,.md,.sql,.sh,.bash,.zsh
