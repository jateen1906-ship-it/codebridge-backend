APP_NAME="CodeBridge Verification Service"
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=false
HOST=0.0.0.0
PORT=8007
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# PostgreSQL database owned exclusively by Verification Service
DATABASE_URL=postgresql+asyncpg://postgres:change_me_local_only@localhost:5432/codebridge_verification
DB_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Peer services
IDENTITY_SERVICE_URL=http://localhost:8001
PROJECT_SERVICE_URL=http://localhost:8002
GITHUB_SERVICE_URL=http://localhost:8003
REVIEW_SERVICE_URL=http://localhost:8006
NOTIFICATION_SERVICE_URL=http://localhost:8009
AUDIT_SERVICE_URL=http://localhost:8011
SERVICE_CLIENT_TIMEOUT_SECONDS=10.0
INTERNAL_SERVICE_KEY=dev-internal-service-key-change-me

# Cryptographic HMAC-SHA256 signing configuration
VERIFICATION_SIGNING_SECRET=dev-verification-hmac-secret-change-me-32chars
VERIFICATION_SIGNING_KEY_ID=cb-verify-v1
