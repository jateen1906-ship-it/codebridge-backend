# CodeBridge Workspace Service — Environment Configuration Example
APP_NAME=CodeBridge Workspace Service
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=false
HOST=0.0.0.0
PORT=8005
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# PostgreSQL Database (database-per-service: codebridge_workspace)
DATABASE_URL=postgresql+asyncpg://postgres:change_me_local_only@localhost:5432/codebridge_workspace
DB_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Peer Microservice URLs (synchronous HTTPX)
IDENTITY_SERVICE_URL=http://localhost:8001
PROJECT_SERVICE_URL=http://localhost:8002
GITHUB_SERVICE_URL=http://localhost:8003
SERVICE_CLIENT_TIMEOUT_SECONDS=10.0

# Isolated Workspace Storage & Container Runtime
# Supported WORKSPACE_DOCKER_MODE values: docker | mock
WORKSPACE_DOCKER_MODE=mock
WORKSPACE_STORAGE_ROOT=./workspace_data
WORKSPACE_DEFAULT_IMAGE=python:3.13-slim
WORKSPACE_ALLOWED_IMAGES=python:3.13-slim,node:20-slim,ubuntu:24.04
WORKSPACE_CPU_LIMIT=1.0
WORKSPACE_MEMORY_LIMIT_MB=512
WORKSPACE_PIDS_LIMIT=128
WORKSPACE_NETWORK_DISABLED=true
WORKSPACE_TTL_HOURS=24
WORKSPACE_MAX_ACTIVE_PER_USER=5

# Archive Validation & Extraction Limits
WORKSPACE_MAX_ARCHIVE_BYTES=10485760
WORKSPACE_MAX_EXTRACT_BYTES=52428800
WORKSPACE_MAX_EXTRACT_FILES=2000
WORKSPACE_MAX_COMPRESSION_RATIO=50.0
WORKSPACE_LOG_TAIL_LINES=200
