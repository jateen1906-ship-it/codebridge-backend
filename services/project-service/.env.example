# ==============================================================================
# CodeBridge Project Service — Environment Configuration Example (Phase 3)
# ==============================================================================
# Copy to .env for local development. Never commit real secrets or .env files.

APP_NAME=CodeBridge Project Service
APP_ENV=development
DEBUG=false
HOST=0.0.0.0
PORT=8002
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# Async PostgreSQL Database URL (Development placeholder)
DATABASE_URL=postgresql+asyncpg://postgres:change_me_local_only@localhost:5432/codebridge_project
DB_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Synchronous Identity Service HTTPX Integration
IDENTITY_SERVICE_URL=http://localhost:8001
IDENTITY_SERVICE_TIMEOUT_SECONDS=5.0

# Domain Defaults
DEFAULT_CURRENCY=INR
