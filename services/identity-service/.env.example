# ==============================================================================
# CodeBridge Identity Service — Environment Configuration Example (Phase 2)
# ==============================================================================
# Copy to .env for local development. Never commit real secrets or .env files.

APP_NAME=CodeBridge Identity Service
APP_ENV=development
DEBUG=false
HOST=0.0.0.0
PORT=8001
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# Async PostgreSQL Database URL (Development placeholder)
DATABASE_URL=postgresql+asyncpg://postgres:change_me_local_only@localhost:5432/codebridge_identity

# JWT Signing Configuration (MUST be set to a strong 32+ byte secret in production)
JWT_SECRET_KEY=dev-only-insecure-secret-key-change-before-production-32bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Password Hashing
PASSWORD_HASHING_SCHEME=argon2
