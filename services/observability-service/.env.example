APP_NAME=CodeBridge Observability Service
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=false
HOST=0.0.0.0
PORT=8012
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://postgres:change_me_local_only@localhost:5432/codebridge_observability
DB_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

IDENTITY_SERVICE_URL=http://localhost:8001
API_GATEWAY_URL=http://localhost:8000
PROJECT_SERVICE_URL=http://localhost:8002
GITHUB_SERVICE_URL=http://localhost:8003
CODE_CONTEXT_SERVICE_URL=http://localhost:8004
WORKSPACE_SERVICE_URL=http://localhost:8005
REVIEW_SERVICE_URL=http://localhost:8006
VERIFICATION_SERVICE_URL=http://localhost:8007
PAYMENT_SERVICE_URL=http://localhost:8008
NOTIFICATION_SERVICE_URL=http://localhost:8009
ADMIN_SERVICE_URL=http://localhost:8010
AUDIT_SERVICE_URL=http://localhost:8011

OBSERVABILITY_PROBE_TIMEOUT_SECONDS=3.0
SERVICE_CLIENT_TIMEOUT_SECONDS=10.0
INTERNAL_SERVICE_KEY=dev-internal-service-key-change-me
