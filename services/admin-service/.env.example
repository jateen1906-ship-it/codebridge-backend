APP_NAME="CodeBridge Admin Service"
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=false
HOST=0.0.0.0
PORT=8010
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://postgres:change_me_local_only@localhost:5432/codebridge_admin
DB_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

IDENTITY_SERVICE_URL=http://localhost:8001
PROJECT_SERVICE_URL=http://localhost:8002
PAYMENT_SERVICE_URL=http://localhost:8008
AUDIT_SERVICE_URL=http://localhost:8011
NOTIFICATION_SERVICE_URL=http://localhost:8009
SERVICE_CLIENT_TIMEOUT_SECONDS=10.0
INTERNAL_SERVICE_KEY=dev-internal-service-key-change-me
