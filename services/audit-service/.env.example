APP_NAME="CodeBridge Audit Service"
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=false
HOST=0.0.0.0
PORT=8011
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://postgres:change_me_local_only@localhost:5432/codebridge_audit
DB_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

IDENTITY_SERVICE_URL=http://localhost:8001
PROJECT_SERVICE_URL=http://localhost:8002
SERVICE_CLIENT_TIMEOUT_SECONDS=10.0
INTERNAL_SERVICE_KEY=dev-internal-service-key-change-me
