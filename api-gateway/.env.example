# ==============================================================================
# CodeBridge API Gateway — Environment Configuration Example (Phase 1)
# ==============================================================================
# Copy to .env for local development. Never commit real secrets.

APP_NAME=CodeBridge API Gateway
APP_ENV=development
DEBUG=false
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# Comma-separated explicit origins (or JSON array)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=false

# Synchronous HTTPX client timeouts & connection pool limits
REQUEST_TIMEOUT_SECONDS=10.0
CONNECT_TIMEOUT_SECONDS=5.0
HTTP_MAX_CONNECTIONS=100
HTTP_MAX_KEEPALIVE_CONNECTIONS=20

# Downstream Microservice Base URLs (Environment-Configurable)
IDENTITY_SERVICE_URL=http://localhost:8001
PROJECT_SERVICE_URL=http://localhost:8002
GITHUB_SERVICE_URL=http://localhost:8003
CODE_CONTEXT_SERVICE_URL=http://localhost:8004
WORKSPACE_SERVICE_URL=http://localhost:8005
REVIEW_SERVICE_URL=http://localhost:8006
VERIFICATION_SERVICE_URL=http://localhost:8007
PAYMENT_SERVICE_URL=http://localhost:8008
NOTIFICATION_SERVICE_URL=http://localhost:8009
ADMIN_SERVICE_URL=http://localhost:8010
AUDIT_SERVICE_URL=http://localhost:8011
OBSERVABILITY_SERVICE_URL=http://localhost:8012
