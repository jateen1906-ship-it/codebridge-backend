# ==============================================================================
# CodeBridge Backend — Root Environment Configuration Example
# ==============================================================================
# Copy to .env for Docker Compose or local orchestration. Never commit real secrets.

APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL (Docker Compose / local — use 5433 if a local Windows Postgres already occupies 5432)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Frontend CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=false

# Shared Dev Security Secrets (MUST replace with random >=32-char secrets in production)
JWT_SECRET_KEY=dev-only-insecure-secret-key-change-before-production-32bytes
INTERNAL_SERVICE_KEY=dev-internal-service-key-change-me
VERIFICATION_SIGNING_SECRET=dev-verification-hmac-secret-change-me-32chars
GITHUB_TOKEN_ENCRYPTION_KEY=REVWX09OTFlfSU5TRUNVUkVfS0VZX0RPX05PVF9VU0U=

# GitHub OAuth App Placeholders
GITHUB_CLIENT_ID=dev-github-client-id-placeholder
GITHUB_CLIENT_SECRET=dev-github-client-secret-placeholder
GITHUB_OAUTH_CALLBACK_URL=http://localhost:8000/api/v1/github/oauth/callback

# Code Context Providers (mock/none safe defaults)
EMBEDDING_PROVIDER=mock
LLM_PROVIDER=none

# Service Ports & Base URLs (local host defaults)
API_GATEWAY_PORT=8000
IDENTITY_SERVICE_PORT=8001
PROJECT_SERVICE_PORT=8002
GITHUB_SERVICE_PORT=8003
CODE_CONTEXT_SERVICE_PORT=8004
WORKSPACE_SERVICE_PORT=8005
REVIEW_SERVICE_PORT=8006
VERIFICATION_SERVICE_PORT=8007
PAYMENT_SERVICE_PORT=8008
NOTIFICATION_SERVICE_PORT=8009
ADMIN_SERVICE_PORT=8010
AUDIT_SERVICE_PORT=8011
OBSERVABILITY_SERVICE_PORT=8012
HTTP_CLIENT_TIMEOUT_SECONDS=10.0
