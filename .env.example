# ==============================================================================
# CodeBridge Backend — Root Environment Configuration Example (Phase 0)
# ==============================================================================
# Copy to .env for future local orchestration. Do NOT commit real secrets.
# All values below are local development placeholders only.

APP_ENV=development
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# Planned Service Ports & Internal Base URLs
# ------------------------------------------------------------------------------
API_GATEWAY_PORT=8000
API_GATEWAY_URL=http://localhost:8000

IDENTITY_SERVICE_PORT=8001
IDENTITY_SERVICE_URL=http://localhost:8001

PROJECT_SERVICE_PORT=8002
PROJECT_SERVICE_URL=http://localhost:8002

GITHUB_SERVICE_PORT=8003
GITHUB_SERVICE_URL=http://localhost:8003

CODE_CONTEXT_SERVICE_PORT=8004
CODE_CONTEXT_SERVICE_URL=http://localhost:8004

WORKSPACE_SERVICE_PORT=8005
WORKSPACE_SERVICE_URL=http://localhost:8005

REVIEW_SERVICE_PORT=8006
REVIEW_SERVICE_URL=http://localhost:8006

VERIFICATION_SERVICE_PORT=8007
VERIFICATION_SERVICE_URL=http://localhost:8007

PAYMENT_SERVICE_PORT=8008
PAYMENT_SERVICE_URL=http://localhost:8008

NOTIFICATION_SERVICE_PORT=8009
NOTIFICATION_SERVICE_URL=http://localhost:8009

ADMIN_SERVICE_PORT=8010
ADMIN_SERVICE_URL=http://localhost:8010

AUDIT_SERVICE_PORT=8011
AUDIT_SERVICE_URL=http://localhost:8011

OBSERVABILITY_SERVICE_PORT=8012
OBSERVABILITY_SERVICE_URL=http://localhost:8012

# ------------------------------------------------------------------------------
# Inter-Service Synchronous HTTP Communication Defaults (Planned)
# ------------------------------------------------------------------------------
HTTP_CLIENT_TIMEOUT_SECONDS=10.0

